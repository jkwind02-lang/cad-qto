  "common_issue_links": [{"path": "review_data/common_issue_links.csv", "columns": {"common_issue_id": "共性问题编号", "item_id": "条目编号"}}],
  "members": [{"path": "review_data/ledger_members.csv", "constants": {"professional": "qto-electrical-routes", "category": "回路"},
