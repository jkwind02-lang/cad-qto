{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qto-ambiguity-protocol/1.0",
  "description": "Maintenance-only schemas; evaluate_ambiguities.py also checks identities, evidence, pairing and asset isolation.",
  "oneOf": [
    {
      "$ref": "#/$defs/input"
    },
    {
      "$ref": "#/$defs/reference"
    },
    {
      "$ref": "#/$defs/run"
    }
  ],
  "$defs": {
    "quantity": {
      "type": "object",
      "required": [
        "value",
        "unit",
        "basis"
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "tolerance": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "target": {
      "type": "object",
      "required": [
        "target_id",
        "kind",
        "question",
        "answer_format",
        "locator_handles"
      ],
      "properties": {
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "OBJECT",
            "RELATION",
            "JUDGMENT"
          ]
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "answer_format": {
          "type": "string",
          "minLength": 1
        },
        "locator_handles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": true
    },
    "group": {
      "type": "object",
      "required": [
        "group_id",
        "source_id",
        "split",
        "isolation_keys",
        "targets"
      ],
      "properties": {
        "group_id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "split": {
          "enum": [
            "DEBUG",
            "SEALED"
          ]
        },
        "isolation_keys": {
          "type": "object",
          "required": [
            "floor",
            "frame",
            "block_family"
          ],
          "properties": {
            "floor": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "frame": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "block_family": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": true
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/target"
          }
        }
      },
      "additionalProperties": true
    },
    "input": {
      "type": "object",
      "required": [
        "schema_version",
        "benchmark_id",
        "sources",
        "assets",
        "groups",
        "coverage_regions"
      ],
      "properties": {
        "schema_version": {
          "const": "qto-ambiguity-input/1.0"
        },
        "benchmark_id": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source_id",
              "sha256"
            ],
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "additionalProperties": true
          }
        },
        "assets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "additionalProperties": true
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/group"
          }
        },
        "coverage_regions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "region_id",
              "source_id",
              "split"
            ],
            "properties": {
              "region_id": {
                "type": "string",
                "minLength": 1
              },
              "source_id": {
                "type": "string",
                "minLength": 1
              },
              "split": {
                "enum": [
                  "DEBUG",
                  "SEALED"
                ]
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "reference_target": {
      "type": "object",
      "required": [
        "target_id",
        "decision_status",
        "acceptable_conclusions",
        "evidence_refs",
        "basis",
        "quantity"
      ],
      "properties": {
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "decision_status": {
          "enum": [
            "DECIDABLE",
            "INSUFFICIENT",
            "ADJUDICATION_REQUIRED"
          ]
        },
        "acceptable_conclusions": {
          "type": "array"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "quantity": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/quantity"
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "reference": {
      "type": "object",
      "required": [
        "schema_version",
        "input_sha256",
        "authority",
        "targets",
        "coverage_regions"
      ],
      "properties": {
        "schema_version": {
          "const": "qto-ambiguity-reference/1.0"
        },
        "input_sha256": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "type": "object",
          "required": [
            "kind",
            "decision_subject",
            "human_approved"
          ],
          "properties": {
            "kind": {
              "const": "INDEPENDENT_MODEL_FROM_SOURCE"
            },
            "decision_subject": {
              "type": "string",
              "minLength": 1
            },
            "human_approved": {
              "const": false
            },
            "approval_evidence": {
              "type": "null"
            }
          },
          "additionalProperties": true
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference_target"
          }
        },
        "coverage_regions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "region_id",
              "expected_objects",
              "expected_relations",
              "census_basis"
            ],
            "properties": {
              "region_id": {
                "type": "string",
                "minLength": 1
              },
              "expected_objects": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "expected_relations": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "census_basis": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "claim": {
      "type": "object",
      "required": [
        "target_id",
        "status",
        "conclusion",
        "evidence_refs",
        "quantity"
      ],
      "properties": {
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "DETERMINED",
            "UNRESOLVED"
          ]
        },
        "conclusion": {},
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "quantity": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/quantity"
            }
          ]
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "UNRESOLVED"
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ],
            "properties": {
              "conclusion": {
                "type": "null"
              },
              "quantity": {
                "type": "null"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "run": {
      "type": "object",
      "required": [
        "schema_version",
        "input_sha256",
        "run_id",
        "version_label",
        "pair_id",
        "replicate",
        "model_config",
        "budget",
        "human_review_minutes",
        "claims",
        "coverage_regions"
      ],
      "properties": {
        "schema_version": {
          "const": "qto-ambiguity-run/1.0"
        },
        "input_sha256": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "version_label": {
          "type": "string",
          "minLength": 1
        },
        "pair_id": {
          "type": "string",
          "minLength": 1
        },
        "replicate": {
          "type": "integer",
          "minimum": 1
        },
        "model_config": {
          "type": "object",
          "required": [
            "model",
            "effort"
          ],
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1
            },
            "effort": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        },
        "budget": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "human_review_minutes": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "coverage_regions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "region_id",
              "scanned_all_scope",
              "object_ids",
              "relation_ids"
            ],
            "properties": {
              "region_id": {
                "type": "string",
                "minLength": 1
              },
              "scanned_all_scope": {
                "type": "boolean"
              },
              "object_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "relation_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  }
}
